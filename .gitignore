# Data pack: treated as personal data (brief §7). Never commit it.
/pack/

# Working files that are not part of the required submission
/IMPLEMENTATION_PLAN.md
/notes/
/scripts/
/tests/test_explore_pack.py
**/.gitkeep

# sample_run: only the outputs the brief asks for are committed.
# Everything else is regenerated by `python -m ott_agent run`.
sample_run/*
!sample_run/decisions.jsonl
!sample_run/actions.jsonl
!sample_run/outcomes.jsonl
!sample_run/latency_report.json
!sample_run/impact_report.md
!sample_run/final_report.md
!sample_run/viewer_state/

# Local environment and build output
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
build/
dist/

# Runtime state
*.db
*.db-journal
